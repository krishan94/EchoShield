rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication & Authorization Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection:
    // - Authenticated users can read member profile data
    // - Only the owner can write or update their own profile document
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if false; // Accounts cannot be deleted directly via client Firestore
    }

    // Family Relationships collection:
    // - Members field contains array of exactly two UIDs [userA, userB]
    // - Only participants of a relationship can read or remove it
    match /family_relationships/{relationshipId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.members);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.members);
      allow update, delete: if isAuthenticated() && (request.auth.uid in resource.data.members);
    }

    // Family Invitations collection:
    // - Senders can read, create, and cancel their outgoing invitations
    // - Recipients can read and update (accept/reject) their incoming invitations
    match /family_invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_email == request.auth.token.email ||
        resource.data.recipient_id == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.sender_id == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.sender_id == request.auth.uid ||
        resource.data.recipient_email == request.auth.token.email ||
        resource.data.recipient_id == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.sender_id == request.auth.uid;
    }

    // Biometric Voice Consents collection:
    // - Only the account owner can view or record their informed biometric consent
    match /voice_consents/{userId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Consents are updated to 'revoked', never deleted for compliance auditing
    }

    // Biometric Voice Profiles collection:
    // - Encrypted embeddings are strictly private to the authenticated owner
    // - Family members and unauthorized third parties cannot read biometric vectors
    match /voice_profiles/{userId} {
      allow read, create, update, delete: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}

